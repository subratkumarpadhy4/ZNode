{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZNode Telemetry — Phase 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machine_id", "type", "operating_state",
    "kw", "temp", "production_rate",
    "units_produced", "defects", "timestamp"
  ],
  "properties": {
    "machine_id":      { "enum": ["M1", "M2", "M3"] },
    "type":            { "enum": ["CNC", "FURNACE", "KILN"] },
    "operating_state": { "enum": ["IDLE", "ACTIVE_CUTTING", "ACTIVE_BURN", "SETUP", "MAINTENANCE", "COOLDOWN"] },
    "kw":              { "type": "number", "minimum": 0, "maximum": 10000 },
    "temp":            { "type": "number", "minimum": -50, "maximum": 3000 },
    "production_rate": { "type": "number", "minimum": 0, "maximum": 100000 },
    "units_produced":  { "type": "number", "minimum": 0 },
    "defects":         { "type": "integer", "minimum": 0 },
    "timestamp":       { "type": "integer" }
  }
}
